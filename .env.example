# Authenticated iKAOS Story API. No local Story repository is required.
IKAOS_STORY_API_URL=https://your-ikaos-preview.vercel.app
IKAOS_STORY_API_TOKEN=

# Optional Story preview origin. This creates preview links; it does not deploy.
IKAOS_STORY_PREVIEW_URL=http://localhost:3000

# Designer image storage through the existing df-sheet API.
DF_SHEET_URL=https://your-df-sheet.vercel.app
DF_SHEET_PROJECT_ID=

# Current image authentication: short-lived df-login review access token.
# Never commit this value.
DF_SHEET_ACCESS_TOKEN=
