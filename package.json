{
  "name": "@designfever/mcp-ikaos-story",
  "version": "0.1.0",
  "description": "MCP server for editing iKAOS Story prototype content through the authenticated Story API.",
  "type": "module",
  "bin": {
    "mcp-ikaos-story": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/index.ts",
    "smoke": "tsx test/smoke.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  },
  "license": "UNLICENSED"
}
